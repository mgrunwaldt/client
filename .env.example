# Match backend
# Keep this as /api for local development so Vite can proxy requests to the backend.
VITE_MATCH_BACKEND_URL=/api
VITE_MATCH_BACKEND_PROXY_TARGET=http://localhost:3000

# Local HTTPS
# Set to true only after creating the certificate files with `pnpm mkcert`.
VITE_LOCAL_HTTPS=false
VITE_HTTPS_KEY_PATH=dev-key.pem
VITE_HTTPS_CERT_PATH=dev.pem

# Public Dojo/Cartridge configuration
VITE_PUBLIC_DEPLOY_TYPE=sepolia
VITE_PUBLIC_NODE_URL=https://api.cartridge.gg/x/starknet/sepolia
VITE_PUBLIC_TORII=https://api.cartridge.gg/x/full-starter-react/torii
VITE_PUBLIC_MASTER_ADDRESS=
VITE_PUBLIC_SLOT_ADDRESS=

# Optional public analytics configuration
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=

# Never place private keys or other secrets in a VITE_ variable: Vite exposes them
# to browser code. Keep VITE_PUBLIC_MASTER_PRIVATE_KEY unset.
